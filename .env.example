# Copy to .env and fill in:  cp .env.example .env

# ---- Model ------------------------------------------------------------------
# "provider:model". The default is Claude Haiku 4.5 through our Bifrost gateway (needs BIFROST_API_KEY below).
MODEL=bifrost:bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
# MODEL=bifrost:bedrock/global.anthropic.claude-sonnet-4-6
# MODEL=bedrock_converse:global.anthropic.claude-sonnet-4-6   # straight to Amazon Bedrock (AWS_BEARER_TOKEN_BEDROCK)
# MODEL=bedrock_converse:global.anthropic.claude-haiku-4-5-20251001-v1:0   # cheaper and faster
# MODEL=mock                              # fully offline: no key, deterministic, ignores prompts
# MODEL=openrouter:openai/gpt-6-luna      # any model on openrouter.ai, one key for all
# MODEL=openai:gpt-4o-mini
# MODEL=anthropic:claude-sonnet-4-5
# MODEL=azure_openai:<your-deployment-name>
# MODEL=ollama:llama3.1

# Optional per-agent overrides (role name in capitals), e.g. cheap router, strong validator:
# MODEL_SUPERVISOR=openai:gpt-4o-mini
# MODEL_VALIDATION_AGENT=openai:gpt-4o

# Leave blank (TEMPERATURE=) for models that reject it, e.g. openai:gpt-6-luna
TEMPERATURE=0
# Rate limits (429), timeouts and 5xx errors are retried with backoff this many times (default 4)
# MODEL_MAX_RETRIES=4

# ---- Provider keys (only the one you use) ---------------------------------------
# Bifrost gateway (OpenAI-compatible): its address, without /v1, and your Bifrost key.
BIFROST_URL=https://bifrost.asean-lab.com
BIFROST_API_KEY=
# Amazon Bedrock: a Bedrock API key (starts with ABSK). Normal AWS credentials work too.
AWS_BEARER_TOKEN_BEDROCK=
# The Bedrock endpoint you call (Singapore). A global. model ID then lets AWS run it in any region.
AWS_REGION=ap-southeast-1
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Lab 4 (Hermes) uses Bifrost if BIFROST_API_KEY is set, then Bedrock, OpenRouter, OpenAI.
# HERMES_PROVIDER=bifrost       # bifrost, bedrock, openrouter or openai, to choose yourself
# HERMES_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=2024-10-21

# ---- Embeddings (RAG) ---------------------------------------------------------------
# "hash" = offline keyword-style embeddings. For real semantic search:
EMBEDDING_MODEL=hash
# EMBEDDING_MODEL=openai:text-embedding-3-small

# ---- Infrastructure (docker compose sets these for you) -------------------------------
# Empty = in-memory vector store + in-memory checkpointer, in-process Mock Gov API.
DATABASE_URL=
GOV_API_URL=

# ---- Behaviour ----------------------------------------------------------------------
HUMAN_APPROVAL=true
VERBOSE=true

# ---- Optional hosted tracing (LangSmith) -------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-workflows-workshop
