# Copy to .env and fill in:  cp .env.example .env
# More settings (other providers, Bedrock direct, Lab 4 overrides, embeddings, ...) are in .env.backup.

# ---- Model ------------------------------------------------------------------
# "provider:model". The default is Claude Haiku 4.5 through our Bifrost gateway.
MODEL=bifrost:bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
# MODEL=mock      # fully offline: no key, deterministic, ignores prompts

# ---- Bifrost gateway ------------------------------------------------------------
# OpenAI-compatible: its address (without /v1) and your Bifrost key.
BIFROST_URL=https://bifrost.asean-lab.com
BIFROST_API_KEY=

# ---- Tracing (LangSmith) ------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-workflows-workshop

# ---- Behaviour ----------------------------------------------------------------------
HUMAN_APPROVAL=true
VERBOSE=true
