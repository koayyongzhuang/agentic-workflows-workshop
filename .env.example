# Copy to .env and fill in:  cp .env.example .env

# ---- Model ------------------------------------------------------------------
# "provider:model". Leave as "mock" to run fully offline (no key, deterministic).
MODEL=mock
# MODEL=openrouter:openai/gpt-6-luna      # any model on openrouter.ai, one key for all
# MODEL=openai:gpt-4o-mini
# MODEL=anthropic:claude-sonnet-4-5
# MODEL=azure_openai:<your-deployment-name>
# MODEL=bedrock_converse:anthropic.claude-3-5-sonnet-20240620-v1:0
# MODEL=ollama:llama3.1

# Optional per-agent overrides (role name in capitals), e.g. cheap router, strong validator:
# MODEL_SUPERVISOR=openai:gpt-4o-mini
# MODEL_VALIDATION_AGENT=openai:gpt-4o

TEMPERATURE=0
# Rate limits (429), timeouts and 5xx errors are retried with backoff this many times (default 4)
# MODEL_MAX_RETRIES=4

# ---- Provider keys (only the one you use) ---------------------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=2024-10-21

# ---- Embeddings (RAG) ---------------------------------------------------------------
# "hash" = offline keyword-style embeddings. For real semantic search:
EMBEDDING_MODEL=hash
# EMBEDDING_MODEL=openai:text-embedding-3-small

# ---- Infrastructure (docker compose sets these for you) -------------------------------
# Empty = in-memory vector store + in-memory checkpointer, in-process Mock Gov API.
DATABASE_URL=
GOV_API_URL=

# ---- Behaviour ----------------------------------------------------------------------
HUMAN_APPROVAL=true
VERBOSE=true

# ---- Optional hosted tracing (LangSmith) -------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-workflows-workshop
